# --- Core ---
DATABASE_URL=postgresql://user:pass@localhost:5432/xom
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
# 32-byte hex (64 chars): openssl rand -hex 32  -> encrypts OAuth tokens at rest
ENCRYPTION_KEY=
# 32-byte hex: openssl rand -hex 32 -> encrypts X developer credentials saved in Settings (keep separate from ENCRYPTION_KEY)
CREDENTIALS_ENCRYPTION_KEY=
# random 32+ chars: openssl rand -base64 48 -> signs session cookies
SESSION_SECRET=
# --- Owner login (created by `npm run db:seed`) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# --- X API (https://developer.x.com) ---
# Optional fallback: you can instead save the Client ID/Secret in Settings → X Integration (database wins).
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/api/x/callback
# Provider for accounts NOT connected via OAuth (demo/tests). Real OAuth-connected accounts always use the X API.
# mock | x   (mock never touches the network)
X_PROVIDER=mock
# true = worker records what WOULD be sent but never calls X
DRY_RUN=true
# --- Optional ---
ANTHROPIC_API_KEY=
SMTP_URL=
NOTIFY_EMAIL=
